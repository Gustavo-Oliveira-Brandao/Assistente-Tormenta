// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "./src/main/api/prisma"
}

datasource db {
  provider = "sqlite"
  url      = "./src/main/UserData/db.sqlite"
}

model Personagem {
  id Int @id @default(autoincrement())
  nome String
  categoria String
  tipo String
  nivel Int
  tamanho String
  detalhesPJ DetalhesPJ?
  detalhesAmeaca DetalhesAmeaca?
  classes Classe[]
  atributos Atributo[]
  pericias Pericia[]
  status Status?
  deslocamentos Deslocamento?
  poderes Poder[]
  grimorio Grimorio?
  proficiencias Proficiencia[]
  efeitos Efeito[]
}

model DetalhesPJ {
  id Int @id @default(autoincrement())
  raca String
  classeOriginal String
  origem String
  divindade String
  experiencia String
  alinhamentoEtico String
  alinhamentoMoral String
  personagem Personagem @relation(fields: [personagemId], references: [id])
  personagemId Int @unique
}

model DetalhesAmeaca {
  id Int @id @default(autoincrement())
  papelCombate String
  subTipo String?
  tesouro String?
  personagem Personagem @relation(fields: [personagemId], references: [id])
  personagemId Int @unique
}

model Classe {
  id Int @id @default(autoincrement())
  nome String
  nivel Int
  vidaInicial Int
  vidaPorNivel Int
  devotoFiel Boolean
  manaPorNivel Int
  personagem Personagem @relation(fields: [personagemId], references: [id])
  personagemId Int
}

model Atributo {
  id Int @id @default(autoincrement())
  nome String
  key String
  valorBase Int
  bonus Int
  personagem Personagem @relation(fields: [personagemId], references: [id])
  personagemId Int
}

model Pericia {
  id Int @id @default(autoincrement())
  nome String
  bonus Int
  ehTreinado Boolean
  categoria String
  atributo String
  requerTreinamento Boolean
  sofrePenalidadeArmadura Boolean
  personagem Personagem @relation(fields: [personagemId], references: [id])
  personagemId Int
}

model Status {
  id Int @id @default(autoincrement())
  vidaAtual Int
  vidaMaximaBonus Int
  vidaTemporaria Int
  atributoVidaMaxima String
  manaAtual Int
  manaMaximaBonus Int
  atributoManaMaxima String
  defesaBase Int
  defesaBonus Int
  atributoDefesa String
  personagem Personagem @relation(fields: [personagemId], references: [id])
  personagemId Int @unique
}

model Deslocamento {
  id Int @id @default(autoincrement())
  caminhadaBase Int
  vooBase Int
  natacaoBase Int
  escaladaBase Int
  escavacaoBase Int
  plana Boolean
  personagem Personagem @relation(fields: [personagemId], references: [id])
  personagemId Int @unique
}

model Poder {
  id Int @id @default(autoincrement())
  key String
  icone String?
  nome String
  tempoExecucao String
  descricao String
  categoria String
  nivel Int
  preRequisitos String
  publicacao String
  fonte String
  subEfeitos SubEfeito[]
  tags Tag[]
  personagem Personagem @relation(fields: [personagemId], references: [id])
  personagemId Int
}

model SubEfeito {
  id Int @id @default(autoincrement())
  nome String
  descricao String
  poder Poder @relation(fields: [poderId], references: [id])
  poderId Int
}

model Tag {
  id Int @id @default(autoincrement())
  label String
  poder Poder @relation(fields: [poderId], references: [id])
  poderId Int
}

model Grimorio {
  id Int @id @default(autoincrement())
  atributoChaveMagias String
  bonusCD Int
  magias Magia[]
  personagem Personagem @relation(fields: [personagemId], references: [id])
  personagemId Int @unique
}

model Magia {
  id Int @id @default(autoincrement())
  key String
  nome String
  alvo String
  area String
  efeito String
  execucao String
  resistencia String
  descricao String
  duracao String
  nivelCirculo Int
  alcance String
  tradicao String
  publicacao String
  escola String
  aprimoramentos AprimoramentoMagia[]
  grimorio Grimorio @relation(fields: [grimorioId], references: [id])
  grimorioId Int
}

model AprimoramentoMagia {
  id Int @id @default(autoincrement())
  custo Int
  descricao String
  magia Magia @relation(fields: [magiaId], references: [id])
  magiaId Int
}

model Proficiencia {
  id Int @id @default(autoincrement())
  categoria String
  nome String
  personagem Personagem @relation(fields: [personagemId], references: [id])
  personagemId Int
}

model Efeito {
  id Int @id @default(autoincrement())
  nome String
  estaAtivo Boolean
  fonte String
  modificadores Modificador[]
  personagem Personagem @relation(fields: [personagemId], references: [id])
  personagemId Int
}

model Modificador {
  id Int @id @default(autoincrement())
  tipo String
  alvo String
  modoBonus String
  valor Int
  estaAtivo Boolean
  escalonamento String
  efeito Efeito @relation(fields: [efeitoId], references: [id])
  efeitoId Int
}